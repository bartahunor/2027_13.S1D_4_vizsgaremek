<UserControl x:Class="TudasterAdmin.Views.ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Grid Background="#F7F6F9">

		<StackPanel Margin="40">

			<TextBlock Text="Új érettségi"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#17121F"/>

			<TextBlock Text="Oktatási Hivatal dokumentum importálása"
                       FontSize="15"
                       Foreground="#77727D"
                       Margin="0,8,0,30"/>

			<Border Background="White"
                    CornerRadius="16"
                    Padding="30">

				<StackPanel>

					<TextBlock Text="PDF dokumentum"
                               FontSize="20"
                               FontWeight="SemiBold"/>

					<TextBlock Text="Válaszd ki a feldolgozni kívánt érettségi PDF fájlt."
                               Margin="0,8,0,25"
                               Foreground="#77727D"/>

					<Button Content="PDF kiválasztása"
                            Width="180"
                            Height="45"
                            HorizontalAlignment="Left"
                            Background="#351F5B"
                            Foreground="White"
                            BorderThickness="0"
                            Click="SelectPdf_Click"/>

					<TextBlock x:Name="FileNameText"
                               Text="Nincs kiválasztott fájl"
                               Margin="0,15,0,0"
                               Foreground="#77727D"/>

				</StackPanel>

			</Border>

		</StackPanel>

	</Grid>

</UserControl>