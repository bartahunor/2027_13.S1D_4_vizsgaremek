<Application x:Class="TudasterAdmin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="LoginWindow.xaml">

    <Application.Resources>

        <!-- Közös színrendszer mint a Tailwindbe-->


        <SolidColorBrush x:Key="PrimaryBrush"
                         Color="#351F5B"/>

        <SolidColorBrush x:Key="PrimaryDarkBrush"
                         Color="#24123D"/>

        <SolidColorBrush x:Key="PrimaryLightBrush"
                         Color="#4B2A7F"/>

        <SolidColorBrush x:Key="BackgroundBrush"
                         Color="#F7F6F9"/>

        <SolidColorBrush x:Key="WhiteBrush"
                         Color="#FFFFFF"/>

        <SolidColorBrush x:Key="TextBrush"
                         Color="#27222E"/>

        <SolidColorBrush x:Key="MutedTextBrush"
                         Color="#8A8491"/>

        <SolidColorBrush x:Key="BorderBrush"
                         Color="#E8E3EC"/>

        <SolidColorBrush x:Key="GlowBrush"
                         Color="#7C3AED"/>

        <Style x:Key="SidebarButtonStyle"
   TargetType="Button">

            <Setter Property="Background"
        Value="Transparent"/>

            <Setter Property="Foreground"
        Value="{StaticResource WhiteBrush}"/>

            <Setter Property="BorderThickness"
        Value="0"/>

            <Setter Property="HorizontalContentAlignment"
        Value="Left"/>

            <Setter Property="Padding"
        Value="15,0"/>

            <Setter Property="FontSize"
        Value="14"/>

            <Setter Property="Cursor"
        Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                    Background="{TemplateBinding Background}"
                    CornerRadius="10"
                    Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                    VerticalAlignment="Center"
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- Hover -->
                            <Trigger Property="IsMouseOver"
                         Value="True">

                                <Setter TargetName="ButtonBorder"
                            Property="Background"
                            Value="#4B2A7F"/>

                            </Trigger>

                            <!-- Lenyomás -->
                            <Trigger Property="IsPressed"
                         Value="True">

                                <Setter TargetName="ButtonBorder"
                            Property="Background"
                            Value="#5B3695"/>

                            </Trigger>

                            <!-- Kikapcsolt állapot -->
                            <Trigger Property="IsEnabled"
                         Value="False">

                                <Setter Property="Opacity"
                            Value="0.5"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Application.Resources>
    


</Application>
