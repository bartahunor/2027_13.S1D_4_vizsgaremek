<Window x:Class="TudasterAdmin.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tudástér Admin - Bejelentkezés"
        Width="500"
        Height="650"
        MinWidth="450"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">

    <Grid>

        <!-- Háttér fény -->
        <Ellipse Width="400"
                 Height="400"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="-180,-180,0,0"
                 Fill="{StaticResource PrimaryLightBrush}"
                 Opacity="0.08"/>

        <Ellipse Width="300"
                 Height="300"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,-120,-120"
                 Fill="{StaticResource GlowBrush}"
                 Opacity="0.06"/>


        <!-- Tartalom -->
        <Grid Margin="55">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- LOGÓ -->
            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center"
                        Margin="0,35,0,0">

                <TextBlock Text="TUDÁSTÉR"
                           HorizontalAlignment="Center"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"/>

                <TextBlock Text="ADMIN"
                           HorizontalAlignment="Center"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,5,0,0"/>

            </StackPanel>


            <!-- BEJELENTKEZÉSI FORM -->
            <StackPanel Grid.Row="1"
                        VerticalAlignment="Center">

                <TextBlock Text="Bejelentkezés"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"/>

                <TextBlock Text="Jelentkezz be az adminisztrációs felületre."
                           FontSize="13"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,7,0,30"
                           TextWrapping="Wrap"/>


                <!-- E-MAIL -->
                <TextBlock Text="E-mail cím"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"/>

                <TextBox x:Name="EmailTextBox"
                         Height="45"
                         Margin="0,8,0,20"
                         Padding="14,0"
                         VerticalContentAlignment="Center"
                         FontSize="14"
                         BorderBrush="{StaticResource BorderBrush}"
                         BorderThickness="1"/>


                <!-- JELSZÓ -->
                <TextBlock Text="Jelszó"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"/>

                <PasswordBox x:Name="PasswordBox"
                             Height="45"
                             Margin="0,8,0,10"
                             Padding="14,0"
                             FontSize="14"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1"/>


                <!-- HIBAÜZENET -->
                <TextBlock x:Name="ErrorTextBlock"
                           Text=""
                           Foreground="#C0392B"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Margin="0,0,0,15"/>


                <!-- BEJELENTKEZÉS -->
                <Button x:Name="LoginButton"
                        Content="BEJELENTKEZÉS"
                        Height="48"
                        Margin="0,10,0,0"
                        Background="{StaticResource PrimaryBrush}"
                        Foreground="{StaticResource WhiteBrush}"
                        BorderThickness="0"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="LoginButton_Click"/>

            </StackPanel>


            <!-- ALSÓ SZÖVEG -->
            <TextBlock Grid.Row="2"
                       Text="Tudástér Adminisztrációs rendszer"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="11"
                       Margin="0,0,0,10"/>

        </Grid>

    </Grid>

</Window>