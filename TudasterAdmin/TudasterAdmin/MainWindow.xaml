<Window x:Class="TudasterAdmin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tudástér Admin"
        Width="1500"
        Height="900"
        MinWidth="1200"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Grid>

        <!-- Főablak -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- =============================== -->
        <!-- OLDALSÁV                         -->
        <!-- =============================== -->

        <Border Grid.Column="0"
                Background="{StaticResource PrimaryDarkBrush}">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>


                <!-- LOGÓ / NÉV -->
                <StackPanel Grid.Row="0"
                            Margin="25,30,25,35">

                    <TextBlock Text="TUDÁSTÉR"
                               Foreground="{StaticResource WhiteBrush}"
                               FontSize="24"
                               FontWeight="Bold"/>

                    <TextBlock Text="ADMIN"
                               Foreground="#BDB5C9"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="1,3,0,0"/>

                </StackPanel>


                <!-- MENÜ -->
                <StackPanel Grid.Row="1"
                            Margin="15,0">

                    <TextBlock Text="FŐMENÜ"
                               Foreground="#8F849E"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Margin="12,0,0,10"/>


                    <!-- Áttekintés -->
                    <Button Content="Áttekintés"
                        Height="45"
                        Margin="0,3"
                        Style="{StaticResource SidebarButtonStyle}"
                        Click="DashboardButton_Click"/>


                    <!-- Feladatok -->
                    <Button Content="Feladatok"
                        Height="45"
                        Margin="0,3"
                        Style="{StaticResource SidebarButtonStyle}"
                        Click="TasksButton_Click"/>

                    <Button Content="Érettségi feladatsorok"
                        Height="45"
                        Margin="0,3"
                        Style="{StaticResource SidebarButtonStyle}"
                        Click="ExamSetsButton_Click"/>

                    <Button Content="Tantárgyak"
                        Height="45"
                        Margin="0,3"
                        Style="{StaticResource SidebarButtonStyle}"
                        Click="SubjectsButton_Click"/>

                    <Button Content="Témakörök"
                        Height="45"
                        Margin="0,3"
                        Style="{StaticResource SidebarButtonStyle}"
                        Click="TopicsButton_Click"/>

                    <Button Content="Importálás"
                        Height="45"
                        Margin="0,3"
                        Style="{StaticResource SidebarButtonStyle}"
                        Click="ImportButton_Click"/>

                     <Button Content="Felhasználók"
                        Height="45"
                        Margin="0,3"
                        Style="{StaticResource SidebarButtonStyle}"
                        Click="UsersButton_Click"/>

                     <Button Content="Statisztikák"
                        Height="45"
                        Margin="0,3"
                        Style="{StaticResource SidebarButtonStyle}"
                        Click="StatisticsButton_Click"/>

                    <Button Content="Beállítások"
                        Height="45"
                        Margin="0,3"
                        Style="{StaticResource SidebarButtonStyle}"
                        Click="SettingsButton_Click"/>

                </StackPanel>


                <!-- ALSÓ RÉSZ -->
                <StackPanel Grid.Row="2"
                            Margin="25,20,25,25">

                    <Border Height="1"
                            Background="#3D3150"
                            Margin="0,0,0,20"/>

                    <TextBlock Text="Adminisztrációs felület"
                               Foreground="#8F849E"
                               FontSize="11"/>

                    <TextBlock Text="Tudástér"
                               Foreground="{StaticResource WhiteBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Margin="0,3,0,0"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- =============================== -->
        <!-- FŐ TARTALOM                     -->
        <!-- =============================== -->

        <Grid Grid.Column="1"
              Margin="35">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>


            <!-- FEJLÉC -->
            <Grid Grid.Row="0">

                <StackPanel>

                    <TextBlock x:Name="PageTitleText"
                        Text="Áttekintés"
                        FontSize="30"
                        FontWeight="Bold"
                        Foreground="{StaticResource TextBrush}"/>

                    <TextBlock x:Name="PageSubtitleText"
                        Text="A Tudástér rendszer áttekintése"
                        FontSize="14"
                        Foreground="{StaticResource MutedTextBrush}"
                        Margin="0,5,0,0"/>

                </StackPanel>

            </Grid>


            <!-- TARTALOM -->
            <ContentControl x:Name="ContentArea"
                Grid.Row="1"
                Margin="0,30,0,0">

                <ScrollViewer x:Name="DashboardContent"
                  VerticalScrollBarVisibility="Auto">
                    <StackPanel>


                        <!-- Üdvözlő kártya -->
                        <Border Background="{StaticResource PrimaryBrush}"
                            CornerRadius="20"
                            Padding="30"
                            Margin="0,0,0,25">

                            <StackPanel>

                                <TextBlock Text="Üdvözlünk a Tudástér Adminban! 👋"
                                       Foreground="{StaticResource WhiteBrush}"
                                       FontSize="24"
                                       FontWeight="Bold"/>

                                <TextBlock Text="Innen kezelheted az érettségi feladatokat, feladatsorokat és a rendszer tartalmait."
                                       Foreground="#DDD5E7"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"/>

                            </StackPanel>

                        </Border>


                        <!-- STATISZTIKAI KÁRTYÁK -->
                        <Grid Margin="0,0,0,25">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>


                            <!-- Feladatok -->
                            <Border Grid.Column="0"
                        Background="{StaticResource WhiteBrush}"
                        CornerRadius="16"
                        Padding="22"
                        Margin="0,0,10,0"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">

                                <StackPanel>

                                    <TextBlock Text="FELADATOK"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource MutedTextBrush}"/>

                                    <TextBlock x:Name="TaskCountText"
                   Text="0"
                   FontSize="30"
                   FontWeight="Bold"
                   Foreground="{StaticResource PrimaryBrush}"
                   Margin="0,8,0,0"/>

                                    <TextBlock Text="Összes feladat"
                   FontSize="12"
                   Foreground="{StaticResource MutedTextBrush}"/>

                                </StackPanel>

                            </Border>


                            <!-- Feladatsorok -->
                            <Border Grid.Column="1"
                                Background="{StaticResource WhiteBrush}"
                                CornerRadius="16"
                                Padding="22"
                                Margin="10,0"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1">

                                <StackPanel>

                                    <TextBlock Text="FELADATSOROK"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedTextBrush}"/>

                                    <TextBlock x:Name="ExamSetCountText"
                                           Text="0"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}"
                                           Margin="0,8,0,0"/>

                                    <TextBlock Text="Érettségi feladatsor"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedTextBrush}"/>

                                </StackPanel>

                            </Border>


                            <!-- Felhasználók -->
                            <Border Grid.Column="2"
                                Background="{StaticResource WhiteBrush}"
                                CornerRadius="16"
                                Padding="22"
                                Margin="10,0"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1">

                                <StackPanel>

                                    <TextBlock Text="FELHASZNÁLÓK"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedTextBrush}"/>

                                    <TextBlock x:Name="UserCountText"
                                            Text="0"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}"
                                           Margin="0,8,0,0"/>

                                    <TextBlock Text="Regisztrált felhasználó"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedTextBrush}"/>

                                </StackPanel>

                            </Border>


                            <!-- Ellenőrzés -->
                            <Border Grid.Column="3"
                                Background="{StaticResource WhiteBrush}"
                                CornerRadius="16"
                                Padding="22"
                                Margin="10,0,0,0"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1">

                                <StackPanel>

                                    <TextBlock Text="ELLENŐRZÉS"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedTextBrush}"/>

                                    <TextBlock x:Name="ReviewCountText"
                                           Text="0"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextBrush}"
                                           Margin="0,8,0,0"/>

                                    <TextBlock Text="Ellenőrzésre vár"
                                           FontSize="12"
                                           Foreground="{StaticResource MutedTextBrush}"/>

                                </StackPanel>

                            </Border>

                        </Grid>


                        <!-- ALSÓ KÁRTYA -->
                        <Border Background="{StaticResource WhiteBrush}"
                            CornerRadius="16"
                            Padding="25"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">

                            <StackPanel>

                                <TextBlock Text="Rendszer állapota"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"/>

                                <TextBlock Text="Az adminisztrációs rendszer készen áll a használatra."
                                       FontSize="13"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="0,6,0,20"/>

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>


                                    <StackPanel Grid.Column="0">

                                        <TextBlock Text="Adatbázis"
                                               FontSize="12"
                                               Foreground="{StaticResource MutedTextBrush}"/>

                                        <TextBlock Text="Nincs csatlakoztatva"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"
                                               Margin="0,4,0,0"/>

                                    </StackPanel>


                                    <StackPanel Grid.Column="1">

                                        <TextBlock Text="Feldolgozó"
                                               FontSize="12"
                                               Foreground="{StaticResource MutedTextBrush}"/>

                                        <TextBlock Text="Inaktív"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"
                                               Margin="0,4,0,0"/>

                                    </StackPanel>


                                    <StackPanel Grid.Column="2">

                                        <TextBlock Text="Utolsó szinkronizáció"
                                               FontSize="12"
                                               Foreground="{StaticResource MutedTextBrush}"/>

                                        <TextBlock Text="Még nem történt"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}"
                                               Margin="0,4,0,0"/>

                                    </StackPanel>

                                </Grid>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </ContentControl>

        </Grid>

    </Grid>

</Window>
