<Window x:Class="TudasterAdmin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tudástér Admin"
        Width="1500"
        Height="900"
        MinWidth="1200"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#F7F6F9">

    <Window.Resources>

        <!-- COLORS -->

        <SolidColorBrush x:Key="Purple"
                         Color="#351F5B"/>

        <SolidColorBrush x:Key="Dark"
                         Color="#17121F"/>

        <SolidColorBrush x:Key="Background"
                         Color="#F7F6F9"/>

        <SolidColorBrush x:Key="White"
                         Color="#FFFFFF"/>

        <SolidColorBrush x:Key="Text"
                         Color="#27222E"/>

        <SolidColorBrush x:Key="Muted"
                         Color="#8A8491"/>

        <SolidColorBrush x:Key="Border"
                         Color="#E8E3EC"/>


        <!-- SIDEBAR BUTTON -->

        <Style x:Key="MenuButton"
               TargetType="Button">

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="#A8A1B0"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Height"
                    Value="46"/>

            <Setter Property="Padding"
                    Value="16,0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Left"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <Setter Property="Background"
                            Value="#241C2D"/>

                    <Setter Property="Foreground"
                            Value="White"/>

                </Trigger>

            </Style.Triggers>

        </Style>


        <!-- PRIMARY -->

        <Style x:Key="PrimaryButton"
               TargetType="Button">

            <Setter Property="Background"
                    Value="#351F5B"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Padding"
                    Value="20,13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

        </Style>

    </Window.Resources>


    <Grid>

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="250"/>

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>


        <!-- ===================================================== -->
        <!-- SIDEBAR -->
        <!-- ===================================================== -->

        <Border Grid.Column="0"
                Background="{StaticResource Dark}">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="110"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="90"/>

                </Grid.RowDefinitions>


                <!-- LOGO -->

                <StackPanel Grid.Row="0"
                            Margin="26,25,20,0">

                    <TextBlock Text="TUDÁSTÉR"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"/>

                    <TextBlock Text="CONTENT ADMIN"
                               Foreground="#8D719F"
                               FontSize="9"
                               FontWeight="Bold"
                               Margin="0,4,0,0"/>

                </StackPanel>


                <!-- MENU -->

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Hidden">

                    <StackPanel Margin="12,10">


                        <TextBlock Text="KEZELÉS"
                                   Foreground="#5F5667"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Margin="16,0,0,8"/>


                        <Button Style="{StaticResource MenuButton}"
                                Content="◉    Áttekintés"
                                Click="Dashboard_Click"/>


                        <Button Style="{StaticResource MenuButton}"
                                Content="↓    Új érettségi"
                                Click="Import_Click"/>


                        <Button Style="{StaticResource MenuButton}"
                                Content="◈    Feldolgozó"
                                Click="Processor_Click"/>


                        <Button Style="{StaticResource MenuButton}"
                                Content="✓    Ellenőrzés"
                                Click="Review_Click"/>


                        <Button Style="{StaticResource MenuButton}"
                                Content="▤    Feladatbázis"
                                Click="Tasks_Click"/>


                        <TextBlock Text="TARTALOM"
                                   Foreground="#5F5667"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Margin="16,28,0,8"/>


                        <Button Style="{StaticResource MenuButton}"
                                Content="○    Tantárgyak"/>


                        <Button Style="{StaticResource MenuButton}"
                                Content="#    Témakörök"/>


                        <Button Style="{StaticResource MenuButton}"
                                Content="◇    Megoldókulcsok"/>


                        <TextBlock Text="STATISZTIKA"
                                   Foreground="#5F5667"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Margin="16,28,0,8"/>


                        <Button Style="{StaticResource MenuButton}"
                                Content="↗    Felhasználók"
                                Click="Users_Click"/>


                        <Button Style="{StaticResource MenuButton}"
                                Content="▥    Gyakorlási adatok"
                                Click="Practice_Click"/>


                        <Button Style="{StaticResource MenuButton}"
                                Content="★    Eredmények"/>


                        <TextBlock Text="RENDSZER"
                                   Foreground="#5F5667"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Margin="16,28,0,8"/>


                        <Button Style="{StaticResource MenuButton}"
                                Content="⚙    Beállítások"/>

                    </StackPanel>

                </ScrollViewer>


                <!-- USER -->

                <Border Grid.Row="2"
                        Background="#211A29"
                        CornerRadius="12"
                        Margin="12"
                        Padding="13">

                    <Grid>

                        <Border Width="36"
                                Height="36"
                                CornerRadius="18"
                                Background="#351F5B" Margin="164,4,0,0">

                            <TextBlock Text="Rendszergazda"
                                       Foreground="#817889"
                                       FontSize="10" Margin="-165,20,49,3"/>

                        </Border>

                        <StackPanel Margin="48,0,0,0"
                                    VerticalAlignment="Center"/>
                        <TextBlock Text="Admin"
                                       Foreground="White"
                                       FontWeight="SemiBold" RenderTransformOrigin="0.493,0.832" Margin="0,10,45,14"/>

                    </Grid>

                </Border>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- MAIN -->
        <!-- ===================================================== -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>

                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>


            <!-- TOP -->

            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="0,0,0,1">

                <Grid Margin="35,0">

                    <TextBlock Text="Tartalomkezelő központ"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Muted}"
                               FontSize="13"/>


                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                        <TextBlock Text="●"
                                   Foreground="#22C55E"
                                   Margin="0,0,7,0"/>

                        <TextBlock Text="Rendszer online"
                                   Foreground="{StaticResource Muted}"
                                   Margin="0,0,25,0"/>

                        <Border Width="34"
                                Height="34"
                                Background="#F1ECF8"
                                CornerRadius="17">

                            <TextBlock Text="A"
                                       Foreground="{StaticResource Purple}"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- CONTENT AREA -->

            <Grid Grid.Row="1"
                  x:Name="ContentArea"
                  Background="{StaticResource Background}"/>

        </Grid>

    </Grid>

</Window>