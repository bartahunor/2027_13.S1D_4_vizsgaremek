<Window x:Class="TudasterAdmin.TaskDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Feladat részletei"
        Width="700"
        Height="650"
        WindowStartupLocation="CenterOwner"
        Background="#F7F6F9">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Fejléc -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Feladat részletei"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#27222E"/>

            <TextBlock Text="A feladat teljes adatlapja"
                       FontSize="14"
                       Foreground="#8A8491"
                       Margin="0,6,0,25"/>
        </StackPanel>

        <!-- Tartalom -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel>

                <TextBlock Text="Feladat"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="#8A8491"/>

                <TextBlock x:Name="TitleText"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="#27222E"
                           TextWrapping="Wrap"
                           Margin="0,6,0,20"/>

                <Grid Margin="0,0,0,20">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Tantárgy"
                                   FontWeight="SemiBold"
                                   Foreground="#8A8491"/>

                        <TextBlock x:Name="SubjectText"
                                   FontSize="15"
                                   Foreground="#27222E"
                                   Margin="0,5,0,15"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Témakör"
                                   FontWeight="SemiBold"
                                   Foreground="#8A8491"/>

                        <TextBlock x:Name="TopicText"
                                   FontSize="15"
                                   Foreground="#27222E"
                                   Margin="0,5,0,15"/>
                    </StackPanel>

                </Grid>

                <Grid Margin="0,0,0,20">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Szint"
                                   FontWeight="SemiBold"
                                   Foreground="#8A8491"/>

                        <TextBlock x:Name="LevelText"
                                   FontSize="15"
                                   Foreground="#27222E"
                                   Margin="0,5,0,15"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Év"
                                   FontWeight="SemiBold"
                                   Foreground="#8A8491"/>

                        <TextBlock x:Name="YearText"
                                   FontSize="15"
                                   Foreground="#27222E"
                                   Margin="0,5,0,15"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Pontszám"
                                   FontWeight="SemiBold"
                                   Foreground="#8A8491"/>

                        <TextBlock x:Name="PointsText"
                                   FontSize="15"
                                   Foreground="#27222E"
                                   Margin="0,5,0,15"/>
                    </StackPanel>

                </Grid>

                <Border Background="White"
                        BorderBrush="#E8E3EC"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18"
                        Margin="0,0,0,15">

                    <StackPanel>
                        <TextBlock Text="Helyes válasz"
                                   FontWeight="SemiBold"
                                   Foreground="#8A8491"/>

                        <TextBlock x:Name="AnswerText"
                                   FontSize="15"
                                   Foreground="#27222E"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                </Border>

                <Border Background="White"
                        BorderBrush="#E8E3EC"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18">

                    <StackPanel>
                        <TextBlock Text="Magyarázat"
                                   FontWeight="SemiBold"
                                   Foreground="#8A8491"/>

                        <TextBlock x:Name="ExplanationText"
                                   FontSize="15"
                                   Foreground="#27222E"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                    </StackPanel>

                </Border>

            </StackPanel>

        </ScrollViewer>

        <!-- Bezárás -->
        <Button Grid.Row="2"
                Content="BEZÁRÁS"
                Width="120"
                Height="40"
                HorizontalAlignment="Right"
                Margin="0,20,0,0"
                Background="#351F5B"
                Foreground="White"
                BorderThickness="0"
                FontWeight="SemiBold"
                Click="CloseButton_Click"/>

    </Grid>

</Window>